<?xml version="1.0" encoding="utf-8"?>
<!-- Rien n'est sauvegardé ni transféré : les mots de passe sont chiffrés par une
     clé du Keystore propre à l'appareil, et les clés privées ne doivent pas en sortir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
